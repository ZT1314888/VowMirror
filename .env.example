# Copy to .env; .env is ignored by Git and Docker build contexts.
# Access token: 32-512 characters. Missing/invalid values fail backend startup.
TRYON_API_KEYS=
# Persistent per-code model attempts per UTC day; successful images are capped at five.
TRYON_DAILY_ATTEMPT_LIMIT=10

# Phase 7: server-only configuration; no real model calls without separate authorization.
# Implemented mapping: chuanapi / gpt-image-2.5-flare / HTTPS API base ending in /v1.
# POST /v1/images/edits: all 4/5 files, one 1536x1024 PNG, quality=medium.
# Empty configuration keeps health/catalog available; generation explicitly returns 503.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Optional Origin CA TLS. Empty values keep both published ports on loopback;
# without origin.crt AND origin.key the web container serves HTTP only.
VOWMIRROR_HTTPS_BIND=
VOWMIRROR_HTTPS_PORT=
VOWMIRROR_SSL_DIR=
# Production: VOWMIRROR_HTTPS_BIND=0.0.0.0, VOWMIRROR_HTTPS_PORT=443,
# VOWMIRROR_SSL_DIR=/etc/ssl/vowmirror (read-only).
# Install origin.crt + origin.key there, and the trusted Cloudflare Origin CA
# root bundle as origin-ca.pem for strict local HTTPS checks. Use Full (strict).
# Keep certificates/keys outside the repository and restrict the private key.
# Server prerequisites: Docker Compose, bash, age, flock, git, curl and python3.
# Put age RECIPIENTS (public keys only) in /etc/vowmirror/backup.age.pub.
# Encrypted backups: /var/backups/vowmirror, retained for 30 days.
# Create that directory writable only by the deployment user; grant that user
# Docker access and read access to the TLS files and public age recipients.
# Initialize /opt/vowmirror with this repository and a private production .env.
# GitHub production Environment: DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY,
# DEPLOY_KNOWN_HOSTS; restrict deployments to main and configure review policy.
