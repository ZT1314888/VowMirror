# Copy to .env; .env is ignored by Git and Docker build contexts.
# Access token: 32-512 characters. Missing/invalid values fail backend startup.
TRYON_API_KEYS=

# Reserved for the future server model configuration. No generation route yet.
# Keep empty in Phase 1; never put model credentials into browser settings.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
