# Copy to .env; .env is ignored by Git and Docker build contexts.
# Access token: 32-512 characters. Missing/invalid values fail backend startup.
TRYON_API_KEYS=

# Phase 3: server-only configuration; no real model calls without separate authorization.
# Implemented mapping: gemini / gemini-3.1-flash-image / HTTPS API base ending in v1beta.
# Empty configuration keeps health/catalog available; generation explicitly returns 503.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
